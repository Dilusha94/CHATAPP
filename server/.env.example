PORT=3000
# Local testing without installing anything: REDIS_URL=memory
# Production (Oracle VM): REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=memory
# Comma-separated list of sites allowed to connect
CLIENT_ORIGIN=http://localhost:5173
# Long random string: openssl rand -hex 32
ADMIN_TOKEN=change-me
IDLE_SECONDS=300
DISCONNECT_GRACE_SECONDS=120
BLOCK_LINKS=true
# Days in the admin Stats tab start at midnight in this time zone
STATS_TIMEZONE=Asia/Colombo
# Moderation records (sign-ins with IP, reports, bans), kept HISTORY_KEEP_DAYS days.
# Empty = built-in database in server/data/history (no install needed).
# PostgreSQL (e.g. aaPanel, docs/03 Step 10A): postgres://chatapp:PASSWORD@127.0.0.1:5432/chatapp
DATABASE_URL=
HISTORY_KEEP_DAYS=365
